# systemd user unit. `xtouch-daemon install-service` writes the same file with the path of the installed executable.
# Manual install: copy to ~/.config/systemd/user/, then `systemctl --user daemon-reload && systemctl --user enable --now xtouch-daemon`.
[Unit]
Description=Behringer X-Touch Extender as a hardware mixer for PipeWire
Documentation=https://github.com/markusressel/xtouch-daemon
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
Type=notify
ExecStart=%h/.local/bin/xtouch-daemon run
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
